# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=
# OPENAI_API_VERSION=2024-10-21  # optional, required for non-v1 API

# TradingAgents web enterprise identity
TRADINGAGENTS_WEB_OIDC_ENABLED=1
TRADINGAGENTS_WEB_OIDC_ISSUER_URL=https://login.example.com/realms/tradingagents
TRADINGAGENTS_WEB_OIDC_AUTHORIZATION_ENDPOINT=https://login.example.com/realms/tradingagents/protocol/openid-connect/auth
TRADINGAGENTS_WEB_OIDC_CLIENT_ID=tradingagents-web
TRADINGAGENTS_WEB_OIDC_CLIENT_SECRET=
TRADINGAGENTS_WEB_OIDC_REDIRECT_URI=https://tradingagents.example.com/auth/oidc/callback
TRADINGAGENTS_WEB_OIDC_SCOPE=openid email profile
TRADINGAGENTS_WEB_OIDC_GROUP_CLAIM=groups
TRADINGAGENTS_WEB_OIDC_GROUP_ROLE_MAPPING={"analysts":{"workspace_id":1,"role":"member"},"auditors":{"workspace_id":1,"role":"viewer"}}
