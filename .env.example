# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Routine run defaults
# Used by `tradingagents <TICKER>` / `./run-fixed.sh <TICKER>` when matching CLI flags are not passed.
TRADINGAGENTS_ANALYSTS=market,social,news,fundamentals
TRADINGAGENTS_QUICK_MODEL=gpt-5.5
TRADINGAGENTS_DEEP_MODEL=gpt-5.5
TRADINGAGENTS_DEPTH=5
TRADINGAGENTS_REASONING_EFFORT=xhigh

# Terminal UI refresh controls; lower refresh reduces flicker.
TRADINGAGENTS_UI_REFRESH_PER_SECOND=0.5
TRADINGAGENTS_UI_UPDATE_INTERVAL_SECONDS=2.0

# Telegram delivery controls. Each generated Markdown report sends a rendered preview plus the original .md file.
TRADINGAGENTS_TELEGRAM_REPORT_PREVIEW_CHARS=1500

# Optional web SSO / retention governance (disabled by default)
TRADINGAGENTS_WEB_OIDC_ENABLED=0
TRADINGAGENTS_WEB_OIDC_ISSUER_URL=
TRADINGAGENTS_WEB_OIDC_AUTHORIZATION_ENDPOINT=
TRADINGAGENTS_WEB_OIDC_CLIENT_ID=
TRADINGAGENTS_WEB_OIDC_CLIENT_SECRET=
TRADINGAGENTS_WEB_OIDC_REDIRECT_URI=
TRADINGAGENTS_WEB_OIDC_GROUP_CLAIM=groups
# JSON object, for example:
# {"tradingagents-analysts":{"workspace_id":1,"role":"member"}}
TRADINGAGENTS_WEB_OIDC_GROUP_ROLE_MAPPING={}
