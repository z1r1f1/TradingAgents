# Copy to .env.web.local and replace secrets before exposing the service.
TRADINGAGENTS_WEB_HTTP_PORT=80
TRADINGAGENTS_WEB_RUNNER=demo
TRADINGAGENTS_WEB_ANALYSIS_WORKERS=1
TRADINGAGENTS_WEB_ENV=development
TRADINGAGENTS_WEB_ALLOW_REGISTRATION=0
TRADINGAGENTS_WEB_AUTH_SECRET=replace-with-a-random-secret-at-least-24-chars
TRADINGAGENTS_WEB_BOOTSTRAP_EMAIL=admin@example.com
TRADINGAGENTS_WEB_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
TRADINGAGENTS_WEB_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Real-runner provider settings. You can also keep these in .env; docker-compose.web.yml loads .env before this file.
# OPENAI_API_KEY=replace-with-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_QUICK_MODEL=gpt-5.5
# TRADINGAGENTS_DEEP_MODEL=gpt-5.5
